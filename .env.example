# Call provider: 'mock' (default) or 'twilio'
CALL_PROVIDER=mock

# Database path (defaults to ./data/mystery-shopper.db)
DB_PATH=./data/mystery-shopper.db

# Path to leads CSV (defaults to ./data/leads.csv)
LEADS_CSV_PATH=./data/leads.csv

# Scheduling
BUSINESS_HOURS_START=11
BUSINESS_HOURS_END=21
MAX_RETRIES=2
RETRY_DELAY_HOURS=2
CALL_CONCURRENCY=3

# OpenAI (optional — enables LLM-based extraction; falls back to regex if absent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Twilio (required only when CALL_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
